cff-version: 1.2.0
message: "If you use this software, please cite it using the metadata from this file."
type: software
title: "dutch-opendata-name-reader"
abstract: >-
  Pipeline that builds lists of Dutch first names and surnames from open data (Kiesraad candidate lists, Wikidata, SSA baby names and Statbel first names). The lists are used as reference data for detecting personal information in the GitHub security infrastructure of the Amsterdam UMC.
authors:
  - family-names: "van der Velde"
    given-names: "Bauke"
    orcid: "https://orcid.org/0000-0002-0365-3862"
    affiliation: "Amsterdam UMC"
  - family-names: "Pronk"
    given-names: "Thomas"
    orcid: "https://orcid.org/0000-0001-9334-7190"
    affiliation: "Amsterdam UMC"
version: 1.0.0
